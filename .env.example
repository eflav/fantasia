# Optional — enables Anthropic Messages API backend (preferred for phone/web)
ANTHROPIC_API_KEY=

# Optional model override (default: claude-sonnet-4-20250514)
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Web server
PORT=3920

# Optional — if set, /api/exec requires Authorization: Bearer <token> or ?token=
# FANTASIA_TOKEN=
